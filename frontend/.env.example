# Public (exposed to the browser)
NEXT_PUBLIC_PRODUCTION=false
# Leave empty in local/dev to use the same-origin /api proxy (see next.config.ts).
# In production, set this to your public API origin, e.g. https://api.pingmynest.com
NEXT_PUBLIC_API_BASE_URL=

# Server-only: upstream API for the Next.js rewrite proxy
API_UPSTREAM=http://localhost:8080
