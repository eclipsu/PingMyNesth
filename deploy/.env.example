# Copy to ~/pingmynest/.env on the Lightsail server and fill in. Never commit it.
# Leave DEVELOPMENT unset: that is what makes the api and worker use real USM.

POSTGRES_PASSWORD=change-me-long-random
DATABASE_URL=postgres://pingmynest:change-me-long-random@postgres:5432/pingmynest?sslmode=disable

# openssl rand -base64 64
JWT_SECRET=

RESEND_API_KEY=
NOTIFY_FROM_EMAIL="PingMyNest <login@pingmynest.lol>"
ALERTS_FROM_EMAIL="PingMyNest <alerts@pingmynest.lol>"
FRONTEND_URL=https://pingmynest.lol

# USM term: 4275 = Spring 2026-2027, 4271 = Fall 2026-2027
TERM_CODE=4275

# Worker: check every watched section once a minute, at most one USM request per 5s
POLL_INTERVAL=1m
USM_REQUEST_GAP=5s

# Caddy is the only proxy in front of the api
TRUSTED_PROXY_HOPS=1

# Shared with Vercel (same value in the Vercel project's env vars) so the API
# can trust the visitor IP Vercel forwards. openssl rand -hex 32
EDGE_SECRET=
